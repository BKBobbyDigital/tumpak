---
const name = "Bobby Tumpak";
const description = "Bobby Tumpak — product leader, Brooklyn, NY.";
const url = "https://bobbytumpak.com";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name,
  url,
  jobTitle: "Product Leader",
  homeLocation: {
    "@type": "Place",
    name: "Brooklyn, New York",
  },
  sameAs: [
    "https://www.linkedin.com/in/tumpak/",
    "https://github.com/BKBobbyDigital",
  ],
};

const projects = [
  { n: "01", title: "DrFirst", href: "https://drfirst.com", desc: "Medication management software for healthcare" },
  { n: "02", title: "HotShit", href: "https://hotshit.xyz", desc: "The best food nearby — no menus, just go" },
  { n: "03", title: "Qart-Hadasht", href: "https://qart-hadasht.org", desc: "Reference encyclopedia of ancient Carthage" },
  { n: "04", title: "The Rothko Room", href: "https://rothkoweather.com", desc: "A Rothko picked for your weather and light" },
  { n: "05", title: "Round the Bases", href: "https://playroundthebases.com", desc: "Daily baseball puzzle game" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={name} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <style>
      :root {
        --paper: #efe7d2;
        --paper-2: #e6dcc0;
        --ink: #1a1410;
        --ink-2: #2b231b;
        --orange: #f15a24;
        --mustard: #f5c14b;
        --cream: #f8f2dd;
        --muted: #5a4e3e;
        --radius: 6px;
        --shadow-pop: 6px 6px 0 var(--ink);
        --shadow-pop-sm: 3px 3px 0 var(--ink);
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; background: var(--paper); color: var(--ink); }
      body {
        font-family: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
        font-size: 15px;
        line-height: 1.55;
        min-height: 100vh;
      }
      a { color: var(--ink); text-underline-offset: 3px; }

      .display { font-family: "Archivo Black", "Inter", system-ui, sans-serif; font-weight: 900; letter-spacing: -0.01em; }
      .micro {
        font-size: 0.7rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }
      .eyebrow {
        font-size: 0.72rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--orange);
      }

      .layout {
        display: grid;
        grid-template-columns: 240px 1fr;
        min-height: 100vh;
        max-width: 1120px;
        margin: 0 auto;
        border-left: 2px solid var(--ink);
        border-right: 2px solid var(--ink);
        background: var(--paper);
      }

      aside.side {
        border-right: 2px solid var(--ink);
        padding: 0 0 2rem;
        position: sticky;
        top: 0;
        align-self: start;
        height: 100vh;
        overflow-y: auto;
        background: var(--paper);
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 1rem;
        padding: 1.1rem 1.25rem;
        border-bottom: 2px solid var(--ink);
      }
      .brand .dot {
        width: 10px; height: 10px;
        border-radius: 50%;
        background: var(--orange);
        box-shadow: 0 0 0 2px var(--ink) inset;
        flex: 0 0 10px;
      }
      .brand .name { font-family: "Archivo Black", system-ui, sans-serif; letter-spacing: 0.02em; }
      .brand .name .accent { color: var(--orange); }

      nav.side-nav { display: flex; flex-direction: column; }
      .nav-group-label {
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: var(--muted);
        padding: 1rem 1.25rem 0.4rem;
      }
      nav.side-nav a {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
        padding: 0.55rem 1.25rem;
        text-decoration: none;
        font-size: 0.9rem;
        border-left: 3px solid transparent;
      }
      nav.side-nav a:hover { background: var(--paper-2); }
      nav.side-nav a.active {
        background: var(--ink);
        color: var(--paper);
        font-weight: 500;
      }
      nav.side-nav a .arrow { color: var(--muted); font-size: 0.8rem; }
      nav.side-nav a:hover .arrow { color: var(--orange); }
      nav.side-nav a.active .arrow { color: var(--orange); }

      .masthead {
        display: flex;
        justify-content: space-between;
        font-size: 0.65rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--muted);
        padding: 0.85rem 2rem;
        border-bottom: 2px solid var(--ink);
      }

      main.content { min-width: 0; }
      .content-inner { padding: 2rem 2rem 3rem; }

      .hero { padding-bottom: 1.5rem; border-bottom: 2px solid var(--ink); margin-bottom: 2rem; }
      .hero .eyebrow { display: inline-flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; }
      .hero .eyebrow .live {
        width: 8px; height: 8px; border-radius: 50%;
        background: var(--orange);
        animation: pulse 1.8s ease-in-out infinite;
      }
      @keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.85); }
      }
      h1.title {
        margin: 0;
        font-family: "Archivo Black", system-ui, sans-serif;
        font-size: clamp(2rem, 6vw, 3.5rem);
        line-height: 1;
        letter-spacing: -0.02em;
      }
      h1.title .highlight {
        position: relative;
        display: inline-block;
      }
      h1.title .highlight::before {
        content: "";
        position: absolute;
        inset-inline: -0.1em;
        top: 0.6em;
        bottom: 0.05em;
        background: var(--mustard);
        z-index: -1;
      }
      h1.title .accent { color: var(--orange); }
      .subtitle {
        color: var(--muted);
        margin: 1rem 0 0;
        font-size: 0.95rem;
        max-width: 38ch;
      }

      .section { margin-top: 2.5rem; }
      .section-head {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
      }
      .section-head h2 {
        margin: 0;
        font-family: "Archivo Black", system-ui, sans-serif;
        font-size: clamp(1.4rem, 3.5vw, 2rem);
        line-height: 1;
        letter-spacing: -0.01em;
      }
      .section-head .eyebrow::before { content: "§ "; }
      .section-head .sub {
        font-size: 0.7rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--muted);
        padding-bottom: 0.25rem;
      }

      .card {
        border: 2px solid var(--ink);
        background: var(--paper);
        padding: 1.25rem 1.25rem 1rem;
        margin-bottom: 1.25rem;
        box-shadow: var(--shadow-pop-sm);
      }
      .card h3 {
        margin: 0 0 0.75rem;
        font-size: 0.85rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        font-weight: 700;
      }
      .card p { margin: 0 0 0.5rem; }
      .card p:last-child { margin-bottom: 0; }

      dl.stats {
        display: grid;
        grid-template-columns: 7rem 1fr;
        gap: 0.4rem 1rem;
        margin: 0;
        font-size: 0.95rem;
      }
      dl.stats dt { color: var(--muted); }
      dl.stats dd { margin: 0; }
      dl.stats dd a { text-decoration: underline; text-decoration-color: var(--orange); text-decoration-thickness: 2px; }
      dl.stats dd a:hover { background: var(--ink); color: var(--paper); text-decoration: none; }

      .grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
      }
      .tile {
        display: block;
        border: 2px solid var(--ink);
        background: var(--paper);
        padding: 1rem 1rem 1.1rem;
        text-decoration: none;
        color: var(--ink);
        box-shadow: var(--shadow-pop-sm);
        transition: transform 120ms ease, box-shadow 120ms ease;
      }
      .tile:hover {
        transform: translate(-2px, -2px);
        box-shadow: var(--shadow-pop);
      }
      .tile-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.5rem;
        border-bottom: 2px solid var(--ink);
        padding-bottom: 0.5rem;
        margin-bottom: 0.6rem;
      }
      .tile-num {
        font-family: "Archivo Black", system-ui, sans-serif;
        font-size: 2.2rem;
        line-height: 1;
        color: var(--orange);
      }
      .tile-step {
        font-size: 0.6rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .tile-title {
        font-family: "Archivo Black", system-ui, sans-serif;
        font-size: 1.05rem;
        letter-spacing: 0.01em;
      }
      .tile-desc {
        margin: 0.3rem 0 0;
        font-size: 0.85rem;
        color: var(--muted);
        line-height: 1.4;
      }
      .tile-link {
        margin-top: 0.6rem;
        font-size: 0.7rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--orange);
      }
      .tile-link::after { content: " →"; }

      footer.bottom {
        margin-top: 2.5rem;
        padding-top: 1rem;
        border-top: 2px solid var(--ink);
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        color: var(--muted);
        font-size: 0.7rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      @media (max-width: 760px) {
        .layout {
          grid-template-columns: 1fr;
          border-left: none;
          border-right: none;
        }
        aside.side {
          position: static;
          height: auto;
          border-right: none;
          border-bottom: 2px solid var(--ink);
          padding-bottom: 0.5rem;
        }
        .masthead { padding: 0.7rem 1.25rem; font-size: 0.55rem; }
        .content-inner { padding: 1.5rem 1.25rem 2.5rem; }
        dl.stats { grid-template-columns: 5.5rem 1fr; }
        .grid { grid-template-columns: 1fr; }
      }
      @media (max-width: 420px) {
        .masthead .right { display: none; }
        dl.stats { grid-template-columns: 1fr; gap: 0.1rem 0; }
        dl.stats dt { margin-top: 0.5rem; }
      }
    </style>
  </head>
  <body>
    <div class="layout">
      <aside class="side">
        <div class="brand">
          <span class="dot" aria-hidden="true"></span>
          <span class="name">TUMPAK<span class="accent">.</span></span>
        </div>
        <nav class="side-nav" aria-label="Primary">
          <div class="nav-group-label">Site</div>
          <a href="#about" class="active">About</a>
          <a href="#projects">Projects</a>

          <div class="nav-group-label">Elsewhere</div>
          <a href="https://www.linkedin.com/in/tumpak/" target="_blank" rel="me noopener">
            <span>LinkedIn</span><span class="arrow">↗</span>
          </a>
          <a href="https://github.com/BKBobbyDigital" target="_blank" rel="me noopener">
            <span>GitHub</span><span class="arrow">↗</span>
          </a>
        </nav>
      </aside>

      <main class="content">
        <div class="masthead">
          <span class="left">N° 001 / PERSONAL FILE</span>
          <span class="right">EST. {new Date().getFullYear()} · BROOKLYN, NY · VOL. 01</span>
        </div>

        <div class="content-inner">
          <section class="hero">
            <div class="eyebrow"><span class="live" aria-hidden="true"></span> ONLINE · BROOKLYN, NY</div>
            <h1 class="title">
              BOBBY<br/>
              <span class="highlight">TUMPAK<span class="accent">.</span></span>
            </h1>
            <p class="subtitle">Product leader. Brooklyn, NY.</p>
          </section>

          <section id="about" class="section">
            <div class="section-head">
              <div>
                <div class="eyebrow">About</div>
                <h2>WHAT I DO.</h2>
              </div>
            </div>
            <div class="card">
              <p>Leading teams that build things that matter.</p>
            </div>
            <div class="card">
              <h3>Details</h3>
              <dl class="stats">
                <dt>name</dt>     <dd>Bobby Tumpak</dd>
                <dt>location</dt> <dd>Brooklyn, NY</dd>
                <dt>linkedin</dt> <dd><a href="https://www.linkedin.com/in/tumpak/">in/tumpak</a></dd>
                <dt>github</dt>   <dd><a href="https://github.com/BKBobbyDigital">@BKBobbyDigital</a></dd>
              </dl>
            </div>
          </section>

          <section id="projects" class="section">
            <div class="section-head">
              <div>
                <div class="eyebrow">Projects</div>
                <h2>THINGS I'M<br/>WORKING ON.</h2>
              </div>
              <div class="sub">FIVE TILES · UPDATED OFTEN</div>
            </div>

            <div class="grid">
              {projects.map((p) => (
                <a class="tile" href={p.href} target="_blank" rel="noopener">
                  <div class="tile-head">
                    <span class="tile-num">{p.n}</span>
                    <span class="tile-step">Project</span>
                  </div>
                  <div class="tile-title">{p.title}</div>
                  <p class="tile-desc">{p.desc}</p>
                  <div class="tile-link">Visit</div>
                </a>
              ))}
            </div>
          </section>

          <footer class="bottom">
            <span>© {new Date().getFullYear()} BOBBY TUMPAK</span>
            <span>BOBBYTUMPAK.COM</span>
          </footer>
        </div>
      </main>
    </div>
  </body>
</html>
