---
const name = "Bobby Tumpak";
const description = "Bobby Tumpak — product leader, Brooklyn, NY.";
const url = "https://bobbytumpak.com";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name,
  url,
  jobTitle: "Product Leader",
  homeLocation: {
    "@type": "Place",
    name: "Brooklyn, New York",
  },
  sameAs: [
    "https://www.linkedin.com/in/tumpak/",
    "https://github.com/BKBobbyDigital",
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={name} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <style>
      :root {
        --bg: #e8e7dc;
        --fg: #111;
        --muted: #4a4a44;
        --line: #111;
        --invert-bg: #111;
        --invert-fg: #e8e7dc;
        --radius: 6px;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; background: var(--bg); color: var(--fg); }
      body {
        font-family: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
        font-size: 15px;
        line-height: 1.55;
        min-height: 100vh;
      }
      a { color: var(--fg); text-underline-offset: 3px; }

      .layout {
        display: grid;
        grid-template-columns: 220px 1fr;
        min-height: 100vh;
        max-width: 1100px;
        margin: 0 auto;
      }

      aside.side {
        border-right: 1px solid var(--line);
        padding: 1.5rem 0 2rem;
        position: sticky;
        top: 0;
        align-self: start;
        height: 100vh;
        overflow-y: auto;
      }
      .brand {
        font-weight: 700;
        font-size: 1.05rem;
        letter-spacing: 0.02em;
        padding: 0 1.25rem 1.25rem;
        border-bottom: 1px solid var(--line);
        margin-bottom: 0.5rem;
      }
      .brand::before { content: "◍ "; }

      nav.side-nav { display: flex; flex-direction: column; }
      .nav-group-label {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--muted);
        padding: 1rem 1.25rem 0.4rem;
      }
      nav.side-nav a {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
        padding: 0.55rem 1.25rem;
        text-decoration: none;
        font-size: 0.95rem;
        border-left: 3px solid transparent;
      }
      nav.side-nav a:hover { background: rgba(0,0,0,0.05); }
      nav.side-nav a.active {
        background: var(--invert-bg);
        color: var(--invert-fg);
        font-weight: 500;
      }
      nav.side-nav a .arrow { color: var(--muted); font-size: 0.8rem; }
      nav.side-nav a.active .arrow { color: var(--invert-fg); }

      main.content {
        padding: 2rem 2rem 3rem;
        min-width: 0;
      }

      main.content h1 {
        margin: 0 0 0.25rem;
        font-size: 1.75rem;
        letter-spacing: -0.01em;
      }
      .subtitle {
        color: var(--muted);
        margin: 0 0 1.5rem;
        font-size: 0.95rem;
      }

      .card {
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 1.25rem 1.25rem 1rem;
        margin-bottom: 1.25rem;
        background: var(--bg);
      }
      .card h2 {
        margin: 0 0 0.75rem;
        font-size: 1rem;
        letter-spacing: 0.01em;
        text-transform: uppercase;
        font-weight: 700;
      }
      .card p { margin: 0 0 0.75rem; }
      .card p:last-child { margin-bottom: 0; }

      dl.stats {
        display: grid;
        grid-template-columns: 7rem 1fr;
        gap: 0.4rem 1rem;
        margin: 0;
        font-size: 0.95rem;
      }
      dl.stats dt { color: var(--muted); }
      dl.stats dd { margin: 0; }
      dl.stats dd a { text-decoration: underline; }
      dl.stats dd a:hover { background: var(--fg); color: var(--bg); text-decoration: none; }

      .section { margin-top: 2rem; }
      .section-head { margin-bottom: 1rem; }
      .section-title {
        font-weight: 700;
        letter-spacing: 0.12em;
        font-size: 0.95rem;
      }
      .section-sub {
        color: var(--muted);
        font-size: 0.9rem;
        margin-top: 0.1rem;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.85rem;
      }
      .tile {
        display: flex;
        gap: 0.85rem;
        align-items: stretch;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 0.65rem;
        background: var(--bg);
        text-decoration: none;
        color: var(--fg);
        min-height: 110px;
      }
      .tile:hover { background: rgba(0,0,0,0.04); }
      .tile.active {
        border-width: 2px;
        padding: calc(0.65rem - 1px);
      }
      .tile-thumb {
        flex: 0 0 96px;
        background: var(--invert-bg);
        color: var(--invert-fg);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.6rem;
        letter-spacing: 0.05em;
        border-radius: 4px;
      }
      .tile-body {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0.15rem;
        min-width: 0;
      }
      .tile-title {
        font-weight: 700;
        font-size: 1rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .tile-tag { font-weight: 400; }
      .tile-meta {
        color: var(--muted);
        font-size: 0.85rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      footer.bottom {
        margin-top: 2rem;
        padding-top: 1rem;
        border-top: 1px solid var(--line);
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        color: var(--muted);
        font-size: 0.8rem;
      }

      @media (max-width: 720px) {
        .layout {
          grid-template-columns: 1fr;
        }
        aside.side {
          position: static;
          height: auto;
          border-right: none;
          border-bottom: 1px solid var(--line);
          padding-bottom: 0.5rem;
        }
        main.content { padding: 1.5rem 1.25rem 2.5rem; }
        main.content h1 { font-size: 1.4rem; }
        dl.stats { grid-template-columns: 5.5rem 1fr; }
        .grid { grid-template-columns: 1fr; }
        .tile-thumb { flex-basis: 72px; font-size: 1.3rem; }
        .tile { min-height: 88px; }
      }
      @media (max-width: 420px) {
        dl.stats { grid-template-columns: 1fr; gap: 0.1rem 0; }
        dl.stats dt { margin-top: 0.5rem; }
      }
    </style>
  </head>
  <body>
    <div class="layout">
      <aside class="side">
        <div class="brand">Bobby Tumpak</div>
        <nav class="side-nav" aria-label="Primary">
          <div class="nav-group-label">Site</div>
          <a href="#about" class="active">About</a>
          <a href="#projects">Projects</a>

          <div class="nav-group-label">Elsewhere</div>
          <a href="https://www.linkedin.com/in/tumpak/" target="_blank" rel="me noopener">
            <span>LinkedIn</span><span class="arrow">↗</span>
          </a>
          <a href="https://github.com/BKBobbyDigital" target="_blank" rel="me noopener">
            <span>GitHub</span><span class="arrow">↗</span>
          </a>
        </nav>
      </aside>

      <main class="content">
        <h1>Bobby Tumpak</h1>
        <p class="subtitle">Product leader · Brooklyn, NY</p>

        <section id="about" class="card">
          <h2>About</h2>
          <p>
            Hi — I'm Bobby. I lead product teams, building software people
            actually use. Based in Brooklyn, New York.
          </p>
        </section>

        <section class="card">
          <h2>Details</h2>
          <dl class="stats">
            <dt>name</dt>     <dd>Bobby Tumpak</dd>
            <dt>location</dt> <dd>Brooklyn, NY</dd>
            <dt>role</dt>     <dd>Product</dd>
            <dt>linkedin</dt> <dd><a href="https://www.linkedin.com/in/tumpak/">in/tumpak</a></dd>
            <dt>github</dt>   <dd><a href="https://github.com/BKBobbyDigital">@BKBobbyDigital</a></dd>
          </dl>
        </section>

        <section id="projects" class="section">
          <div class="section-head">
            <div class="section-title">PROJECTS</div>
            <div class="section-sub">Things I'm working on / have worked on</div>
          </div>

          <div class="grid">
            <a class="tile active" href="https://drfirst.com" target="_blank" rel="noopener">
              <div class="tile-thumb">DR</div>
              <div class="tile-body">
                <div class="tile-title">DrFirst <span class="tile-tag">⌬</span></div>
                <div class="tile-meta">@drfirst</div>
                <div class="tile-meta">Healthcare technology</div>
              </div>
            </a>

            <a class="tile" href="https://hotshit.xyz" target="_blank" rel="noopener">
              <div class="tile-thumb">HS</div>
              <div class="tile-body">
                <div class="tile-title">HotShit <span class="tile-tag">♨</span></div>
                <div class="tile-meta">@hotshit</div>
                <div class="tile-meta">hotshit.xyz</div>
              </div>
            </a>

            <a class="tile" href="https://qart-hadasht.org" target="_blank" rel="noopener">
              <div class="tile-thumb">QH</div>
              <div class="tile-body">
                <div class="tile-title">Qart-Hadasht <span class="tile-tag">▲</span></div>
                <div class="tile-meta">@qarthadasht</div>
                <div class="tile-meta">qart-hadasht.org</div>
              </div>
            </a>
          </div>
        </section>

        <footer class="bottom">
          <span>© {new Date().getFullYear()} Bobby Tumpak</span>
          <span>bobbytumpak.com</span>
        </footer>
      </main>
    </div>
  </body>
</html>
