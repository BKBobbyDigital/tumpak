---
const name = "Bobby Tumpak";
const description = "Bobby Tumpak — product leader, Brooklyn, NY.";
const url = "https://bobbytumpak.com";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name,
  url,
  jobTitle: "Product Leader",
  homeLocation: {
    "@type": "Place",
    name: "Brooklyn, New York",
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={name} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <style>
      :root {
        --bg: #e8e7dc;
        --fg: #111;
        --muted: #4a4a44;
        --line: #111;
        --invert-bg: #111;
        --invert-fg: #e8e7dc;
        --radius: 6px;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; background: var(--bg); color: var(--fg); }
      body {
        font-family: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
        font-size: 15px;
        line-height: 1.55;
        min-height: 100vh;
      }
      a { color: var(--fg); text-underline-offset: 3px; }
      a:hover { background: var(--fg); color: var(--bg); text-decoration: none; }

      .page {
        max-width: 760px;
        margin: 0 auto;
        padding: 2rem 1.25rem 3rem;
      }

      header.top {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        border-bottom: 1px solid var(--line);
        padding-bottom: 1rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
      }
      .brand {
        font-weight: 700;
        font-size: 1.15rem;
        letter-spacing: 0.02em;
      }
      .brand::before { content: "◍ "; }
      .meta {
        color: var(--muted);
        font-size: 0.85rem;
      }

      nav.tabs {
        display: flex;
        gap: 0.25rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
      }
      nav.tabs a {
        padding: 0.35rem 0.85rem;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        text-decoration: none;
        font-size: 0.9rem;
      }
      nav.tabs a.active {
        background: var(--invert-bg);
        color: var(--invert-fg);
      }

      .card {
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 1.25rem 1.25rem 1rem;
        margin-bottom: 1.25rem;
        background: var(--bg);
      }
      .card h1, .card h2 {
        margin: 0 0 0.75rem;
        font-size: 1.5rem;
        letter-spacing: -0.01em;
      }
      .card h2 { font-size: 1.05rem; }
      .card p { margin: 0 0 0.75rem; }
      .card p:last-child { margin-bottom: 0; }

      dl.stats {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 0.4rem 1rem;
        margin: 0;
        font-size: 0.95rem;
      }
      dl.stats dt { color: var(--muted); }
      dl.stats dd { margin: 0; }

      footer.bottom {
        margin-top: 2rem;
        padding-top: 1rem;
        border-top: 1px solid var(--line);
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        color: var(--muted);
        font-size: 0.8rem;
      }
      footer.bottom a { color: var(--muted); }

      @media (max-width: 520px) {
        body { font-size: 14px; }
        .page { padding: 1.25rem 1rem 2rem; }
        .card h1 { font-size: 1.25rem; }
        dl.stats { grid-template-columns: 1fr; gap: 0.1rem 0; }
        dl.stats dt { margin-top: 0.5rem; }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <header class="top">
        <div class="brand">Bobby Tumpak</div>
        <div class="meta">Brooklyn, NY</div>
      </header>

      <nav class="tabs" aria-label="Sections">
        <a href="#about" class="active">About</a>
        <a href="#links">Links</a>
      </nav>

      <section id="about" class="card">
        <h1>Bobby Tumpak</h1>
        <p>Product leader. Based in Brooklyn, New York.</p>
        <dl class="stats">
          <dt>name</dt>     <dd>Bobby Tumpak</dd>
          <dt>location</dt> <dd>Brooklyn, NY</dd>
          <dt>role</dt>     <dd>Product</dd>
          <dt>status</dt>   <dd>[online]</dd>
        </dl>
      </section>

      <section id="links" class="card">
        <h2>Links</h2>
        <dl class="stats">
          <dt>github</dt>   <dd><a href="https://github.com/BKBobbyDigital">@BKBobbyDigital</a></dd>
          <dt>linkedin</dt> <dd><a href="https://www.linkedin.com/in/bobbytumpak">bobbytumpak</a></dd>
        </dl>
      </section>

      <footer class="bottom">
        <span>© {new Date().getFullYear()} Bobby Tumpak</span>
        <span>bobbytumpak.com</span>
      </footer>
    </div>
  </body>
</html>
